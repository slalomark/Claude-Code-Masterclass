// Test mode: allow all reads and writes until 2026-04-14.
// WARNING: These rules are for development only. Update before going to production.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 4, 14);
    }
  }
}
